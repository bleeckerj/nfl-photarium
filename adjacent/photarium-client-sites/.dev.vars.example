LOCAL_DEV_MODE=true
# Optional in local dev. When unset, localhost admin publish routes are allowed
# without auth so a single-operator Photarium instance can publish directly.
# CLIENT_SITES_PUBLISH_SECRET=local-dev-publish-secret
ACCESS_LINK_HASH_SECRET=local-dev-access-secret
SESSION_SIGNING_SECRET=local-dev-session-secret
IMAGES_ACCOUNT_HASH=replace-with-cloudflare-images-account-hash
