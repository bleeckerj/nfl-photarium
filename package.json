{
  "name": "photarium",
  "version": "0.3.2",
  "license": "MIT",
  "private": true,
  "description": "An elegant image management platform powered by Cloudflare Images",
  "scripts": {
    "dev": "AUTO_EMBED_ON_UPLOAD=1 AUTO_EMBED_ON_UPLOAD_LOCAL_PROVIDER=1 AUTO_EMBED_CONCURRENCY=1 next dev --webpack",
    "dev:nocache": "CLOUDFLARE_CACHE_DISABLED=1 npm run dev",
    "dev:full": "./scripts/start-dev.sh",
    "dev:full:nocache": "CLOUDFLARE_CACHE_DISABLED=1 npm run dev:full",
    "dev:full:telegram": "node scripts/start-photarium-with-telegram.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "redis:start": "docker compose up -d",
    "redis:stop": "docker compose down",
    "redis:logs": "docker compose logs -f redis",
    "redis:status": "docker compose ps",
    "embeddings:generate": "node scripts/generate-embeddings.mjs",
    "embeddings:backfill": "node scripts/backfill-embeddings.mjs",
    "embeddings:recover:dry-run": "node scripts/backfill-embeddings.mjs --dry-run --live-verify -v",
    "embeddings:recover": "node scripts/backfill-embeddings.mjs --throttle-ms=300 --batch=20 --delay=2000 --live-verify --checkpoint-file ./data/embedding-backfill-checkpoints/recover-all.json -vv",
    "embeddings:status": "curl -s http://localhost:3000/api/images/vectors/status | jq",
    "prompts:backfill": "node scripts/backfill-prompts.mjs",
    "discord:metadata:backfill": "node scripts/backfill-discord-image-metadata.mjs",
    "migrate:description-alt": "node scripts/migrate-description-alt-to-extras.mjs",
    "count:folder": "node scripts/count-folder-images.mjs",
    "refresh:hash-cache": "node scripts/refresh-hash-cache.mjs",
    "diag:duplicates": "node scripts/diagnose-duplicates.mjs",
    "audit:broken": "node scripts/audit-broken-images.mjs",
    "watch:drop-off": "node scripts/watch-drop-off.mjs",
    "namespace:backfill": "node scripts/backfill-namespace.mjs",
    "namespace:scan": "node scripts/scan-namespaces.mjs",
    "variants:folderize": "node scripts/folder-to-variants.mjs",
    "aspect:backfill": "node scripts/backfill-aspect-ratios.mjs",
    "page:ingest": "node scripts/page-ingest.mjs ingest",
    "page:browser-ingest": "node scripts/page-ingest.mjs browser-ingest",
    "page:auth-help": "node scripts/page-ingest.mjs auth-help",
    "video:frames": "node scripts/video-frames.mjs",
    "fs:ingest": "node scripts/fs-ingest.mjs",
    "media:ingest": "node scripts/dng-ingest.mjs",
    "dng:ingest": "npm run media:ingest --",
    "snagit:ingest": "node scripts/snagit-ingest.mjs",
    "fs:ingest:discord-ingest-latest": "bash scripts/discord-refresh-and-fs-ingest.sh",
    "fs:ingest:discord-refresh-incremental": "npm run fs:ingest:discord-ingest-latest -- --no-ai-metadata --concurrency 8 --throttle-ms 0 --report-cache",
    "fs:ingest:discord-reingest-local": "npm run fs:ingest:discord-ingest-latest -- --skip-discord-refresh --no-ai-metadata --concurrency 8 --throttle-ms 0 --report-cache",
    "ig:auth": "node scripts/instagram-ingest.mjs auth",
    "ig:ingest": "node scripts/instagram-ingest.mjs ingest",
    "ig:url": "node scripts/instagram-ingest.mjs single-url",
    "ig:videos": "node scripts/instagram-ingest.mjs videos-from-ndjson",
    "ig:recover-videos": "node scripts/instagram-video-recover.mjs",
    "flickr:auth": "node scripts/flickr-ingest.mjs auth",
    "flickr:ingest": "node scripts/flickr-ingest.mjs ingest",
    "telegram:listen": "node scripts/telegram-channel-listener.mjs",
    "threads:auth": "node scripts/threads-ingest.mjs auth",
    "threads:url": "node scripts/threads-ingest.mjs single-url"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "clsx": "^2.1.1",
    "exif-reader": "^2.0.2",
    "ioredis": "^5.9.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.545.0",
    "next": "^16.1.1-canary.31",
    "puppeteer": "^24.35.0",
    "qrcode": "^1.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-dropzone": "^14.3.8",
    "sharp": "^0.34.5",
    "undici": "^6.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.4"
  }
}
