# SAMPLE ENV FILE
# Cloudflare Images Configuration
# Get these from your Cloudflare dashboard:
# 1. Account ID: Go to the right sidebar of any page in Cloudflare dashboard
# 2. API Token: Go to My Profile > API Tokens > Create Token
#    - Use "Custom token" template
#    - Add "Cloudflare Images:Edit" permission
#    - Account resources: Include your specific account
# 3. Account Hash: Go to Images > Overview in your Cloudflare dashboard

CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
# Optional: dedicated Cloudflare token for client-site worker deploys.
# When set, the client-sites CLI prefers this over CLOUDFLARE_API_TOKEN.
# Recommended permissions on the target account:
# - Workers Scripts Write
# - D1 Write
# - Account Settings Read
# - Workers Scripts Read
# CLIENT_SITES_CLOUDFLARE_API_TOKEN=your_client_sites_api_token_here
# Optional: managed client-site subdomain automation.
# When these are set, client-site deploys attach per-client hostnames like
# https://andsons.clients.example.com to the dedicated Worker.
# CLIENT_SITES_BASE_DOMAIN=clients.example.com
# CLIENT_SITES_ZONE_ID=your_cloudflare_zone_id_here
# Optional explicit flag; defaults to enabled when both values above are set.
# CLIENT_SITES_USE_CUSTOM_DOMAINS=true
# Optional: dedicated token for Cloudflare Stream operations (recommended)
CLOUDFLARE_STREAM_API_TOKEN=your_stream_api_token_here
NEXT_PUBLIC_CLOUDFLARE_ACCOUNT_HASH=your_account_hash_here
# Optional: custom Stream customer subdomain (for playback URL generation)
# CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=customer-xxxx
IMAGE_NAMESPACE=your_app_namespace
NEXT_PUBLIC_IMAGE_NAMESPACE=your_app_namespace
# Optional: max upload size for video ingest endpoints (bytes)
# MAX_VIDEO_UPLOAD_BYTES=104857600
# Optional: timeout for FFmpeg video rotation encoding (milliseconds)
# VIDEO_ROTATION_TIMEOUT_MS=120000
# Optional: include video assets in /api/images (set to '1' to enable)
# ENABLE_VIDEO_ASSETS=1
# Optional: max number of videos merged into /api/images (default 300)
# VIDEO_ASSET_LIST_LIMIT=300
# Optional: sync Cloudflare Stream status during /api/images list requests (default off)
# VIDEO_STREAM_SYNC_ON_LIST=0

# Grainrad image-tool effects run in-process via the `nfl-grainrad-clone` package
# (no service to start, no configuration required). MP4 animated exports use the
# host `ffmpeg`; override its path with FFMPEG_PATH if it is not on PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Optional: OpenAI key for automatic image metadata generation.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: shared model override for image metadata generators.
# Defaults to gpt-4.1-nano when unset.
# OPENAI_IMAGE_METADATA_MODEL=gpt-4.1-nano
# Optional: per-generator model overrides. These take precedence over
# OPENAI_IMAGE_METADATA_MODEL when set.
# OPENAI_ALT_MODEL=gpt-4.1-nano
# OPENAI_DESCRIPTION_MODEL=gpt-4.1-nano
# OPENAI_DISPLAY_NAME_MODEL=gpt-4.1-nano
# OPENAI_PROMPT_MODEL=gpt-4.1-nano
# OPENAI_TAGS_MODEL=gpt-4.1-nano
# OPENAI_HAIKU_MODEL=gpt-4.1-nano

# Generative aspect-ratio expansion provider. Automatic prefers OpenAI when
# OPENAI_API_KEY is configured, then uses ComfyUI when its workflow is configured.
# PHOTARIUM_ASPECT_RATIO_PROVIDER=auto
# Optional OpenAI image model override for aspect-ratio expansion.
# PHOTARIUM_OPENAI_IMAGE_MODEL=gpt-image-2
# Optional ComfyUI configuration for aspect-ratio expansion.
# COMFY_BASE_URL=http://127.0.0.1:8188
# COMFY_ASPECT_RATIO_WORKFLOW_PATH=/absolute/path/to/aspect-ratio-workflow.json
# Optional node overrides when the workflow uses different node IDs.
# COMFY_ASPECT_RATIO_IMAGE_NODE=109
# COMFY_ASPECT_RATIO_NODE=115
# COMFY_ASPECT_RATIO_POSITIVE_NODE=113
# COMFY_ASPECT_RATIO_NEGATIVE_NODE=114
# COMFY_ASPECT_RATIO_OUTPUT_NODE=79
# COMFY_ASPECT_RATIO_SEED_NODE=
# COMFY_ASPECT_RATIO_TIMEOUT_MS=180000
# COMFY_ASPECT_RATIO_POLL_MS=1000

# Client pages publishing
# The public client-facing worker host, used by Photarium when publishing a client page.
# Example: https://photos.example.com
# CLIENT_SITES_TARGET_BASE_URL=
# Shared publish secret expected by the adjacent photarium-client-sites worker.
# This can be omitted only when publishing to a local dev worker target such as
# http://127.0.0.1:8788 while that worker runs with LOCAL_DEV_MODE=true.
# CLIENT_SITES_PUBLISH_SECRET=
# Legacy fallback name still recognized:
# CLIENT_SITES_ADMIN_API_TOKEN=
# Optional explicit public base URL if it differs from the admin target base URL.
# CLIENT_SITES_PUBLIC_BASE_URL=

# Feature Flag: Disable external upload API (set to 'true' to disable)
DISABLE_EXTERNAL_API=false

# Feature Flag: Allow insecure TLS when importing pages (opt-in per request)
IMPORT_ALLOW_INSECURE_TLS=false

# Cache Storage Configuration
# Options: 'file' (default) or 'redis'
CACHE_STORAGE_TYPE=file
# Redis URL (only used when CACHE_STORAGE_TYPE=redis)
# Run `npm run redis:start` to start Redis via Docker
REDIS_URL=redis://localhost:6379
# Upload-time semantic tags are enabled unless explicitly disabled per upload.
# AUTO_TAGS_ON_UPLOAD=false is an emergency global disable switch.
# SEMANTIC_TAG_QUEUE_STORAGE=redis
# Optional: disable Cloudflare image cache layers entirely (memory + persistent).
# Useful for long-running headless imports when you want minimum cache memory use.
# Values: 1|true|yes|on
# CLOUDFLARE_CACHE_DISABLED=1
